<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
cyc Telegram Bot Daemon - macOS launchd Agent
Save this file to: ~/Library/LaunchAgents/com.candyz.cyc-bot.plist
Load with: launchctl load ~/Library/LaunchAgents/com.candyz.cyc-bot.plist
Unload with: launchctl unload ~/Library/LaunchAgents/com.candyz.cyc-bot.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.candyz.cyc-bot</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Path to cyc executable -->
        <string>/Users/candyz/.local/bin/cyc</string>
        <string>bot</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/cyc-bot.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/cyc-bot.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/Users/candyz/.local/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
